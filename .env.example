NODE_ENV=development
API_PORT=3000
ML_INFERENCE_PORT=8000
ML_INFERENCE_URL=http://ml-inference:8000
ML_INFERENCE_TIMEOUT_MS=300000
ML_INFERENCE_BATCH_TIMEOUT_MS=900000
MODEL_VERSION=age-safety-v1.0.0
KMP_USE_SHM=0
OMP_NUM_THREADS=1
ASSETS_ROOT=assets
THIRD_PARTY_ROOT=third_party
TORCH_HOME=.cache/torch
HF_HOME=.cache/huggingface
AUTO_DOWNLOAD_PUBLIC_ASSETS=0
INSTALL_API_DEPS=0
MODEL_ARTIFACT_DIR=ml/training/outputs/exported
MAIN_MODEL_CHECKPOINT=ml/training/outputs/exported/main_best.pt
AUX_MODEL_CHECKPOINT=ml/training/outputs/exported/aux_best.pt
CALIBRATION_FILE=ml/training/outputs/exported/calibration.json
POLICY_FILE=ml/training/outputs/exported/policy.json
POLICY_SAFE_THRESHOLD=0.05
POLICY_FLAGGED_THRESHOLD=0.40
POLICY_SAFE_AGE_LOWER_BOUND=20.0
ENABLE_INSIGHTFACE=1
INSIGHTFACE_ROOT=assets/insightface
INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_ALLOWED_MODULES=detection
DINOV2_REPO_DIR=third_party/dinov2
ENABLE_EXTERNAL_MIVOLO_HF=0
MIVOLO_HF_MODEL_ID=iitolstykh/mivolo_v2
MIVOLO_HF_DTYPE=float16
MAX_BATCH_FILES=30
